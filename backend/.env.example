# PostgreSQL connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=notesapp
DB_PASSWORD=your_db_password
DB_PORT=5432

# Port the app runs on (http://localhost:PORT)
PORT=5000

# Secret used to sign login tokens. Generate one with: openssl rand -hex 64
JWT_SECRET=change_me

# Error tracking (Faultline). Create a project in the Faultline dashboard to get a key.
FAULTLINE_API_KEY=flt_your_project_api_key
FAULTLINE_ENDPOINT=http://your-faultline-server/v1/ingest
