# Settings for docker compose (server deployment).
# For local development without Docker, use backend/.env instead (see backend/.env.example).

# Password for the app's own PostgreSQL container.
# Only applied when the database volume is first created; changing it later has no effect.
DB_PASSWORD=change_me

# Secret used to sign login tokens. Generate one with: openssl rand -hex 64
JWT_SECRET=change_me

# Host port the app is published on (http://<server-ip>:NOTES_PORT)
NOTES_PORT=4210

# Error tracking (Faultline)
FAULTLINE_API_KEY=flt_your_project_api_key
FAULTLINE_ENDPOINT=http://your-faultline-server/v1/ingest
